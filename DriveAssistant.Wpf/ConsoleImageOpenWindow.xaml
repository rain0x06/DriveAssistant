<Window x:Class="FATXTools.Wpf.ConsoleImageOpenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Open Drive Image"
        Width="660"
        Height="560"
        MinWidth="600"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource PanelBg2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="#F6FAFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource PanelBg2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="IsEditable" Value="False" />
            <Setter Property="IsTextSearchEnabled" Value="True" />
            <Setter Property="MaxDropDownHeight" Value="240" />
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Margin="6"
            Background="{DynamicResource AppBgBrush}"
            BorderBrush="#2D4A78B8"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#4A82C9FF"
                              BlurRadius="10"
                              ShadowDepth="0"
                              Opacity="0.14" />
        </Border.Effect>
    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBgBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Image Source="appicon.ico" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource TitleBarTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        FocusVisualStyle="{x:Null}"
                        Focusable="False"
                        Content="&#xE921;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TitleBarTextBrush}"
                        MinWidth="46"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        ToolTip="Minimize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeWindow_Click" />
                <Button Grid.Column="2"
                        FocusVisualStyle="{x:Null}"
                        Focusable="False"
                        Content="&#xE922;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TitleBarTextBrush}"
                        MinWidth="46"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        ToolTip="Maximize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeRestoreWindow_Click" />
                <Button Grid.Column="3"
                        FocusVisualStyle="{x:Null}"
                        Focusable="False"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TitleBarTextBrush}"
                        MinWidth="46"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        ToolTip="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseWindow_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource AppBgBrush}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,0">
                        <TextBlock Text="Open Drive Image" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Choose the filesystem type. Supply keys only when the image is encrypted."
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="{DynamicResource PanelBgBrush}"
                            BorderBrush="{DynamicResource LineSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="132" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Image" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBox x:Name="ImagePathTextBox"
                                     Grid.Column="1"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     TextChanged="Input_TextChanged" />
                            <Button Grid.Column="2" MinWidth="100" Click="BrowseImage_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" />
                                    <TextBlock Text="Browse" />
                                </StackPanel>
                            </Button>

                            <TextBlock Grid.Row="2" Text="Filesystem type" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ImageKindComboBox"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      MinHeight="34"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      ToolTip="Type in this box to filter filesystem types. Press Down Arrow to open the full list."
                                      Loaded="ImageKindComboBox_Loaded"
                                      SelectionChanged="ImageKindComboBox_SelectionChanged">
                            </ComboBox>

                            <TextBlock Grid.Row="4"
                                       Text="Key file"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ElementName=KeyPathTextBox, Path=Visibility}" />
                            <TextBox x:Name="KeyPathTextBox"
                                     Grid.Row="4"
                                     Grid.Column="1"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     TextChanged="Input_TextChanged"
                                     ToolTip="Optional for already-decrypted PlayStation images." />
                            <Button x:Name="BrowseKeyButton"
                                    Grid.Row="4"
                                    Grid.Column="2"
                                    MinWidth="100"
                                    Click="BrowseKey_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8D7;" />
                                    <TextBlock Text="Browse" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="StatusTextBlock"
                               Grid.Row="3"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Margin="146,12,0,0" />

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Click="Cancel_Click" Margin="0,0,10,0" Width="96">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button x:Name="OpenButton" Style="{StaticResource PrimaryButton}" Click="Open_Click" Width="96">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
    </Border>
</Window>
