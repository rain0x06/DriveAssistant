<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FATX\FATX.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\DriveAssistant.Shared\DiskTypes\RawImage.cs" Link="DiskTypes\RawImage.cs" />
    <Compile Include="..\DriveAssistant.Shared\DiskTypes\CompressedImage.cs" Link="DiskTypes\CompressedImage.cs" />
    <Compile Include="..\DriveAssistant.Shared\DiskTypes\ImgcDecoder.cs" Link="DiskTypes\ImgcDecoder.cs" />
    <Compile Include="..\DriveAssistant.Cli\FatxImageRebuildCommand.cs" Link="Compatibility\FatxImageRebuildCommand.cs" />
    <Compile Include="..\DriveAssistant.Shared\Utilities\BuildInfo.cs" Link="Utilities\BuildInfo.cs" />
    <Compile Include="..\DriveAssistant.Shared\Utilities\CustomSignatureLoader.cs" Link="Utilities\CustomSignatureLoader.cs" />
    <Compile Include="..\DriveAssistant.Shared\Database\DatabaseFile.cs" Link="Database\DatabaseFile.cs" />
    <Compile Include="..\DriveAssistant.Shared\Database\FileDatabase.cs" Link="Database\FileDatabase.cs" />
    <Compile Include="..\DriveAssistant.Shared\Analyzers\IntegrityAnalyzer.cs" Link="Analyzers\IntegrityAnalyzer.cs" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\DriveAssistant.Shared\appicon.ico</ApplicationIcon>
    <AssemblyName>Drive Assistant</AssemblyName>
    <Product>Drive Assistant</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\DriveAssistant.Shared\appicon.ico" Link="appicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\DriveAssistant.Shared\custom_carvers.json" Link="custom_carvers.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DiscUtils.Ntfs" Version="0.16.13" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <Target Name="RunWpfAfterBuild"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(DisableWpfAutoRun)' != 'true' and Exists('$(TargetDir)$(AssemblyName).exe')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$exe = Join-Path '$(TargetDir)' '$(AssemblyName).exe'; if (Test-Path -LiteralPath $exe) { Start-Process -FilePath $exe }&quot;" />
  </Target>

  <Target Name="StopRunningWpfBeforeBuild"
          BeforeTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(DisableWpfAutoRun)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-Process -Name 'Drive Assistant' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue&quot;"
          ContinueOnError="true"
          IgnoreExitCode="true" />
  </Target>

</Project>
