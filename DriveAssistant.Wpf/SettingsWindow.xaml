<Window x:Class="FATXTools.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings"
        Width="920"
        Height="760"
        MinWidth="720"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <Thickness x:Key="SettingsComboFieldPadding">10,0,0,0</Thickness>
        <Thickness x:Key="SettingsTextFieldPadding">3,0,0,0</Thickness>
        <Style x:Key="SettingsComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="{StaticResource SettingsComboFieldPadding}" />
        </Style>
        <Style x:Key="SettingsTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="{StaticResource SettingsTextFieldPadding}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingsShortcutTextBox" TargetType="TextBox" BasedOn="{StaticResource SettingsTextBox}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style x:Key="TitleBarControlButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Margin="8"
            Background="{DynamicResource AppBgBrush}"
            BorderBrush="#2D4A78B8"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#2A5C9CE0"
                              BlurRadius="8"
                              ShadowDepth="0"
                              Opacity="0.09" />
        </Border.Effect>
    <Grid x:Name="RootShell" Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBgBrush}"
                BorderBrush="{DynamicResource LineSoftBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Image Source="appicon.ico" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource TitleBarTextBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource TitleBarControlButton}"
                        Content="&#xE921;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TitleBarTextBrush}"
                        MinWidth="46"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        ToolTip="Minimize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeWindow_Click" />
                <Button Grid.Column="2"
                        Style="{StaticResource TitleBarControlButton}"
                        Content="&#xE922;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TitleBarTextBrush}"
                        MinWidth="46"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        ToolTip="Maximize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeRestoreWindow_Click" />
                <Button Grid.Column="3"
                        Style="{StaticResource TitleBarControlButton}"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="10"
                        Foreground="{DynamicResource TitleBarTextBrush}"
                        MinWidth="46"
                        MinHeight="30"
                        Padding="0"
                        BorderThickness="0"
                        ToolTip="Close"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseWindow_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource AppBgBrush}" Padding="18,16,18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="980">
                        <Border Background="{DynamicResource PanelBgBrush}"
                                BorderBrush="{DynamicResource LineSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Scan profile" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="ScanProfileCombo" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SettingsComboBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Text="Metadata scan workers" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="MetadataWorkersCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SettingsComboBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="4" Text="Metadata interval clusters" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="MetadataIntervalTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SettingsTextBox}" />

                                <TextBlock Grid.Row="6" Text="File carver interval" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="FileCarverIntervalCombo" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SettingsComboBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Grid.Row="8" Text="Theme" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="ThemeCombo" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SettingsComboBox}" />

                                <TextBlock Grid.Row="10" Text="Zero-fill overwritten clusters" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="ZeroFillOverwrittenRecoveryClustersCombo"
                                          Grid.Row="10"
                                          Grid.Column="1"
                                          Grid.ColumnSpan="2"
                                          Style="{StaticResource SettingsComboBox}"
                                          ToolTip="When enabled, recovered exports replace overwritten cluster ranges with zero-filled bytes." />

                                <TextBlock Grid.Row="12" Text="Log to file" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="EnableFileLoggingCombo"
                                          Grid.Row="12"
                                          Grid.Column="1"
                                          Grid.ColumnSpan="2"
                                          Style="{StaticResource SettingsComboBox}" />

                                <TextBlock Grid.Row="14" Text="Log file" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="LogFileTextBox" Grid.Row="14" Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource SettingsTextBox}" />
                                <Button Grid.Row="14" Grid.Column="2" Content="Browse" MinWidth="104" Click="BrowseLog_Click" />

                                <TextBlock Grid.Row="16" Text="Custom carvers file" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="CustomCarversTextBox" Grid.Row="16" Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource SettingsTextBox}" />
                                <Button Grid.Row="16" Grid.Column="2" Content="Browse" MinWidth="104" Click="BrowseCustomCarvers_Click" />
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource PanelBgBrush}"
                                BorderBrush="{DynamicResource LineSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,14,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Keyboard shortcuts" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1"
                                           Text="Click a shortcut cell and press a key combination. Backspace or Delete clears it."
                                           Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,4,0,0" />
                                <Button Grid.Column="1"
                                        Content="Restore Defaults"
                                        MinWidth="132"
                                        VerticalAlignment="Top"
                                        Click="RestoreDefaultShortcuts_Click" />

                                <DataGrid x:Name="ShortcutGrid"
                                          Grid.Row="2"
                                          Grid.ColumnSpan="2"
                                          Margin="0,14,0,0"
                                          MinHeight="280"
                                          RowHeight="40"
                                          ItemsSource="{Binding ShortcutRows, RelativeSource={RelativeSource AncestorType=Window}}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single"
                                          SelectionUnit="Cell"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          ScrollViewer.CanContentScroll="True"
                                          GridLinesVisibility="Horizontal">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Group" Binding="{Binding Category}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Action" Binding="{Binding Name}" Width="*" MinWidth="220" IsReadOnly="True" />
                                        <DataGridTemplateColumn Header="Shortcut" Width="220" MinWidth="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Gesture, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource SettingsShortcutTextBox}"
                                                             BorderBrush="{DynamicResource LineBrush}"
                                                             Background="{DynamicResource InputBgBrush}"
                                                             VerticalAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             PreviewMouseLeftButtonDown="ShortcutTextBox_PreviewMouseLeftButtonDown"
                                                             GotKeyboardFocus="ShortcutTextBox_GotKeyboardFocus"
                                                             PreviewKeyDown="ShortcutTextBox_PreviewKeyDown"
                                                             ToolTip="Press a shortcut, type one manually, or use Backspace/Delete to clear." />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cancel" Width="92" Click="Cancel_Click" />
                    <Button Content="Save" Width="92" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
